<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminDashboardController"
            prefWidth="1100" prefHeight="720"
            stylesheets="@../css/modern-table.css"
            style="-fx-background-color: #F3F4F6; -fx-font-family: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif';">

    <top>
        <BorderPane style="-fx-background-color: #1E3A8A; -fx-border-color: #172554; -fx-border-width: 0 0 1 0; -fx-padding: 16 28;">
            <center>
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="LN"
                           style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A; -fx-background-color: #DBEAFE; -fx-padding: 4 8; -fx-background-radius: 6;"/>
                    <VBox spacing="2">
                        <Label text="Library Nexus"
                               style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: 800; -fx-letter-spacing: -0.5;"/>
                        <Label text="Admin Control Center"
                               style="-fx-text-fill: #93C5FD; -fx-font-size: 11px; -fx-font-weight: 600; -fx-text-transform: uppercase;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.1); -fx-padding: 6 12; -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 20; -fx-border-width: 1;">
                        <Circle radius="12" fill="#93C5FD"/>
                        <Label fx:id="welcomeLabel" text="Admin"
                               style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </HBox>
                </HBox>
            </center>
        </BorderPane>
    </top>

    <left>
        <VBox prefWidth="240"
              style="-fx-background-color: linear-gradient(to bottom, #1E3A8A, #172554); -fx-padding: 24 16; -fx-spacing: 8;">

            <Label text="OVERVIEW"
                   style="-fx-text-fill: #60A5FA; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 0 12 12 12; -fx-letter-spacing: 1.0;"/>

            <Button fx:id="btnManageUsers" text="Users"
                    onAction="#showManageUsers" maxWidth="Infinity"/>

            <Button fx:id="btnAllBooks" text="Books &amp; Inventory"
                    onAction="#showAllBooks" maxWidth="Infinity"/>

            <Button fx:id="btnUserActivity" text="Member Activity"
                    onAction="#showUserActivity" maxWidth="Infinity"/>

            <Button fx:id="btnOverdue" text="Overdue Alerts"
                    onAction="#showOverdue" maxWidth="Infinity"/>

            <Button fx:id="btnAuditLog" text="Security Audit Log"
                    onAction="#showAuditLog" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #93C5FD; -fx-font-weight: 600; -fx-padding: 10 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnReports" text="System Analytics"
                    onAction="#showReports" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #93C5FD; -fx-font-weight: 600; -fx-padding: 10 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Sign Out"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: #FCA5A5; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 12 16; -fx-cursor: hand; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 8;"/>
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-padding: 32;">

            <VBox fx:id="welcomePanel" alignment="CENTER" spacing="16"
                  StackPane.alignment="CENTER">
                <Label text="👋" style="-fx-font-size: 48px;"/>
                <Label text="Welcome to the Workspace"
                       style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                <Label text="Select a module from the sidebar to manage the platform."
                       style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
            </VBox>

            <VBox fx:id="manageUsersPanel" spacing="20"
                  StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                <effect><DropShadow color="#00000008" radius="20" spread="0.0" offsetY="4"/></effect>

                <VBox spacing="4">
                    <Label text="User Management" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    <Label text="View, activate, or suspend accounts across the network." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </VBox>

                <TableView fx:id="userTableView" VBox.vgrow="ALWAYS" prefHeight="400"
                           style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="idColumn"        text="ID"         prefWidth="60"/>
                        <TableColumn fx:id="usernameColumn"  text="Username"   prefWidth="220"/>
                        <TableColumn fx:id="roleColumn"      text="Role"       prefWidth="120"/>
                        <TableColumn fx:id="statusColumn"    text="Status"     prefWidth="100"/>
                        <TableColumn fx:id="lastLoginColumn" text="Last Login" prefWidth="150"/>
                    </columns>
                </TableView>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Button fx:id="deactivateUserBtn" text="Suspend Account" disable="true"
                            style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-font-weight: 700; -fx-padding: 10 20; -fx-background-radius: 6; -fx-font-size: 13px; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="adminStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                </HBox>
            </VBox>

            <VBox fx:id="allBooksPanel" spacing="20"
                  StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                <effect><DropShadow color="#00000008" radius="20" spread="0.0" offsetY="4"/></effect>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Global Inventory" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                        <Label text="Monitor all books and their current status." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="bookSearchField" promptText="Search inventory..." prefWidth="260"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    <Button fx:id="btnRefreshBooks" text="Sync" onAction="#refreshAllBooks"
                            style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-weight: 600; -fx-padding: 8 16; -fx-background-radius: 6; -fx-border-color: #DBEAFE; -fx-border-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="12">
                    <Label fx:id="totalBooksLabel" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6;"/>
                    <Label fx:id="borrowedCountLabel" style="-fx-background-color: #FEF3C7; -fx-text-fill: #B45309; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6;"/>
                    <Label fx:id="availableCountLabel" style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6;"/>
                </HBox>

                <TableView fx:id="allBooksTable" VBox.vgrow="ALWAYS" prefHeight="380"
                           style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="abIsbnCol"       text="ISBN"          prefWidth="130"/>
                        <TableColumn fx:id="abTitleCol"      text="Title"         prefWidth="220"/>
                        <TableColumn fx:id="abAuthorCol"     text="Author"        prefWidth="140"/>
                        <TableColumn fx:id="abGenreCol"      text="Genre"         prefWidth="100"/>
                        <TableColumn fx:id="abOwnerCol"      text="Owner"         prefWidth="110"/>
                        <TableColumn fx:id="abBorrowerCol"   text="Borrowed By"   prefWidth="110"/>
                        <TableColumn fx:id="abBorrowDateCol" text="Borrow Date"   prefWidth="100"/>
                        <TableColumn fx:id="abDueDateCol"    text="Due Date"      prefWidth="100"/>
                        <TableColumn fx:id="abStatusCol"     text="Status"        prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="userActivityPanel" spacing="20"
                  StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                <effect><DropShadow color="#00000008" radius="20" spread="0.0" offsetY="4"/></effect>

                <VBox spacing="4">
                    <Label text="Activity Ledger" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    <Label text="Audit individual member borrow history." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #F9FAFB; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;">
                    <TextField fx:id="userSearchField" promptText="Enter username..." prefWidth="240"
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    <Button text="Audit User" onAction="#loadUserActivity"
                            style="-fx-background-color: #2563EB; -fx-text-fill: #FFFFFF; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="activityUserLabel" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </HBox>

                <HBox fx:id="activityStatsBox" spacing="12" visible="false" managed="false">
                    <Label fx:id="actTotalLabel" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6;"/>
                    <Label fx:id="actActiveLabel" style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6;"/>
                    <Label fx:id="actOverdueLabel" style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6;"/>
                </HBox>

                <TableView fx:id="userActivityTable" VBox.vgrow="ALWAYS" prefHeight="350"
                           style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="uaIsbnCol"       text="ISBN"        prefWidth="130"/>
                        <TableColumn fx:id="uaTitleCol"      text="Title"       prefWidth="220"/>
                        <TableColumn fx:id="uaAuthorCol"     text="Author"      prefWidth="150"/>
                        <TableColumn fx:id="uaBorrowDateCol" text="Borrow Date" prefWidth="110"/>
                        <TableColumn fx:id="uaDueDateCol"    text="Due Date"    prefWidth="110"/>
                        <TableColumn fx:id="uaStatusCol"     text="Status"      prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="overduePanel" spacing="20"
                  StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                <effect><DropShadow color="#00000008" radius="20" spread="0.0" offsetY="4"/></effect>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Compliance &amp; Overdue" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                        <Label text="Track assets that have exceeded their return period." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh Data" onAction="#refreshOverdue"
                            style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #DBEAFE; -fx-border-radius: 6;"/>
                </HBox>

                <HBox fx:id="overdueBanner" spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: #FEF2F2; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #FECACA; -fx-border-radius: 8;">
                    <Label fx:id="overdueCountLabel" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #991B1B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="overdueTodayLabel" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #B91C1C;"/>
                </HBox>

                <TableView fx:id="overdueTable" VBox.vgrow="ALWAYS" prefHeight="380"
                           style="-fx-background-radius: 8; -fx-border-color: #FECACA; -fx-border-radius: 8; -fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="odIsbnCol"       text="ISBN"          prefWidth="130"/>
                        <TableColumn fx:id="odTitleCol"      text="Title"         prefWidth="220"/>
                        <TableColumn fx:id="odAuthorCol"     text="Author"        prefWidth="140"/>
                        <TableColumn fx:id="odBorrowerCol"   text="Borrower"      prefWidth="120"/>
                        <TableColumn fx:id="odOwnerCol"      text="Owner"         prefWidth="120"/>
                        <TableColumn fx:id="odBorrowDateCol" text="Borrow Date"   prefWidth="100"/>
                        <TableColumn fx:id="odDueDateCol"    text="Due Date"      prefWidth="100"/>
                        <TableColumn fx:id="odDaysOverdueCol" text="Delay"        prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="auditLogPanel" spacing="20"
                  StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                <effect><DropShadow color="#00000008" radius="20" spread="0.0" offsetY="4"/></effect>
            </VBox>

            <VBox fx:id="reportsPanel" spacing="20"
                  StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                <effect><DropShadow color="#00000008" radius="20" spread="0.0" offsetY="4"/></effect>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding: 12 28; -fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB transparent transparent transparent; -fx-border-width: 1;">
            <Circle fx:id="systemStatusCircle" radius="4" fill="#9CA3AF"/>
            <Label text="System Operational"
                   style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-weight: 600;"/>
        </HBox>
    </bottom>

</BorderPane>