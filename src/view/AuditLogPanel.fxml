<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AuditLogController">
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4">
            <Label text="Security Audit Log" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
            <Label text="Chronological record of system-wide actions." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="auditSearchField" promptText="Filter by action or user..." prefWidth="260"
                   style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-padding: 8 12;"/>
    </HBox>

    <TableView fx:id="auditTableView" VBox.vgrow="ALWAYS" prefHeight="450"
               style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="180"/>
            <TableColumn fx:id="colActor" text="User" prefWidth="120"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="150"/>
            <TableColumn fx:id="colTarget" text="Object" prefWidth="120"/>
            <TableColumn fx:id="colDetails" text="Full Details" prefWidth="300"/>
        </columns>
    </TableView>
</VBox>