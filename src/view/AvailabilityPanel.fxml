<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.AvailabilityPanelController"
      spacing="0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #E5E7EB; -fx-border-width: 1;"
      prefWidth="500" prefHeight="450">
    <effect><DropShadow color="#0000001A" radius="25" spread="0.0" offsetY="8"/></effect>

    <VBox style="-fx-background-color: #F9FAFB; -fx-padding: 16 24; -fx-background-radius: 12 12 0 0; -fx-border-color: transparent transparent #E5E7EB transparent; -fx-border-width: 1;">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Label text="📚" style="-fx-font-size: 24px; -fx-background-color: #EDE9FE; -fx-padding: 8; -fx-background-radius: 8;"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Available Lenders" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                <Label fx:id="lenderCountLabel" text="Searching network..." style="-fx-font-size: 13px; -fx-text-fill: #6B7280; -fx-font-weight: 600;"/>
            </VBox>

            <Button fx:id="closeBtn" text="✕"
                    style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="lendersContainer" spacing="12" style="-fx-padding: 24; -fx-background-color: #FFFFFF;"/>
        </content>
    </ScrollPane>
</VBox>