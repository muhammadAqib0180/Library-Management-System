<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-padding: 0; -fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AvailabilityPanelController">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Available Copies by Lender" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
        <Label fx:id="resultCountLabel" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="refreshButton" text="Sync"
                style="-fx-background-color: #EDE9FE; -fx-text-fill: #5B21B6; -fx-font-weight: 700; -fx-font-size: 12px; -fx-padding: 6 16; -fx-background-radius: 6; -fx-cursor: hand;" />
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="lenderListContainer" spacing="12" style="-fx-background-color: transparent; -fx-padding: 2;" />
    </ScrollPane>

    <VBox fx:id="emptyStatePane" spacing="12" alignment="CENTER" visible="false" managed="false"
          style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 40;">
        <Label text="📭" style="-fx-font-size: 48px;" />
        <Label text="No copies available" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
        <Label text="All copies are currently borrowed by other members." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" />
    </VBox>

</VBox>