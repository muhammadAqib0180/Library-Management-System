<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Dialog?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<Dialog fx:id="dialog" title="Choose Handover Method" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HandoverMethodDialogController">
    <dialogPane>
        <DialogPane>
            <content>
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Header -->
                    <TextFlow>
                        <Text text="How would you like to exchange the book?" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                    </TextFlow>

                    <!-- Meetup Option -->
                    <HBox spacing="15" style="-fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 15; -fx-cursor: hand;">
                        <VBox spacing="5" fx:id="meetupBox">
                            <Text text="📍 Meetup in Person" style="-fx-font-size: 13; -fx-font-weight: bold;" />
                            <Text text="You and the lender meet at a location. Requires OTP confirmation." style="-fx-font-size: 11; -fx-fill: #666;" wrappingWidth="280" />
                        </VBox>
                    </HBox>

                    <!-- Courier Option -->
                    <HBox spacing="15" style="-fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 15; -fx-cursor: hand;">
                        <VBox spacing="5" fx:id="courierBox">
                            <Text text="🚚 Courier Delivery" style="-fx-font-size: 13; -fx-font-weight: bold;" />
                            <Text text="A delivery service brings the book. Requires proof &amp; confirmation of receipt." style="-fx-font-size: 11; -fx-fill: #666;" wrappingWidth="280" />
                        </VBox>
                    </HBox>

                    <!-- Buttons -->
                    <HBox spacing="10" style="-fx-alignment: center-right;">
                        <Button fx:id="cancelButton" text="Cancel" style="-fx-padding: 8 20;" />
                        <Button fx:id="meetupButton" text="Choose Meetup" style="-fx-padding: 8 20; -fx-font-weight: bold;" />
                        <Button fx:id="courierButton" text="Choose Courier" style="-fx-padding: 8 20; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>
            </content>
        </DialogPane>
    </dialogPane>
</Dialog>
