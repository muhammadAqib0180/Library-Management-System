<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LenderDashboardController"
            prefWidth="980" prefHeight="640"
            style="-fx-background-color: #f0f7f4;">

    <!-- TOP BAR -->
    <top>
        <BorderPane>
            <center>
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-background-color: linear-gradient(to right, #1e5c3a, #16a085);
                             -fx-padding: 14 24;
                             -fx-effect: dropshadow(gaussian, #00000055, 8, 0, 0, 3);">
                    <Label text="📚" style="-fx-font-size: 22px;"/>
                    <VBox spacing="0">
                        <Label text="Library Nexus"
                               style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <Label text="Lender Workspace"
                               style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="welcomeLabel"
                           style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12px;"/>
                    <StackPane prefWidth="30" prefHeight="30" alignment="TOP_RIGHT" style="-fx-padding: 0;">
                        <Label fx:id="notificationBell" text="🔔"
                               style="-fx-font-size: 20px; -fx-text-fill: white; -fx-cursor: hand;"
                               onMouseClicked="#toggleNotificationPanel"
                               StackPane.alignment="CENTER_LEFT"/>
                        <Label fx:id="notificationBadge" text="3"
                               style="-fx-text-fill: white; -fx-background-color: #e74c3c;
                                      -fx-font-size: 9px; -fx-font-weight: bold;
                                      -fx-padding: 0 3; -fx-background-radius: 8;
                                      -fx-alignment: CENTER; -fx-min-width: 16; -fx-min-height: 16;"
                               onMouseClicked="#toggleNotificationPanel"
                               StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>
                    <Button text="Become a Borrower"
                            onAction="#switchToBorrower"
                            style="-fx-background-color: rgba(255,255,255,0.15);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 20;
                                   -fx-border-width: 1;"/>
                </HBox>
            </center>
            <right>
                <VBox fx:id="notificationPanel" visible="false" managed="false"
                      prefWidth="320" maxWidth="320" maxHeight="500" minHeight="100"
                      style="-fx-background-color: white; -fx-border-color: #ddd;
                             -fx-border-radius: 8; -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 2, 4);
                             -fx-padding: 0; -fx-spacing: 0; -fx-border-width: 1;
                             -fx-margin: 8 8 0 0;">
                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-background-color: #16a085; -fx-padding: 12 16;
                                 -fx-text-fill: white; -fx-background-radius: 8 8 0 0;">
                        <Label text="🔔" style="-fx-font-size: 14px;"/>
                        <Label text="Notifications" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#toggleNotificationPanel"
                                style="-fx-font-size: 16px; -fx-text-fill: white;
                                       -fx-background-color: transparent; -fx-cursor: hand;
                                       -fx-padding: 0 4; -fx-minimize-button: true;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="notificationListContainer" spacing="8" style="-fx-padding: 12; -fx-background-color: white;">
                            <Label text="Loading notifications..." style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </right>
        </BorderPane>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="210"
              style="-fx-background-color: #27ae60; -fx-padding: 20 0;">

            <Label text="NAVIGATION"
                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10px;
                          -fx-font-weight: bold; -fx-padding: 0 20 12 20; -fx-letter-spacing: 1.5;"/>

            <Button fx:id="btnAddBook" text="  ＋   Add New Book"
                    onAction="#showAddBookPanel"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(0,0,0,0.2);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;
                           -fx-padding: 14 20; -fx-cursor: hand; -fx-background-radius: 0;
                           -fx-border-color: transparent transparent transparent white;
                           -fx-border-width: 0 0 0 3; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnInventory" text="  📋   My Inventory"
                    onAction="#showInventoryPanel"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;
                           -fx-padding: 14 20; -fx-cursor: hand; -fx-background-radius: 0;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnPendingRequests" text="  ⏳   Requests"
                    onAction="#showPendingRequestsPanel"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;
                           -fx-padding: 14 20; -fx-cursor: hand; -fx-background-radius: 0;
                           -fx-alignment: CENTER_LEFT;"/>

           <Button fx:id="btnLentBooks" text="  📖   Lent Books"
                  onAction="#showLentBooksPanel"
                  maxWidth="Infinity"
                  style="-fx-background-color: transparent;
                        -fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;
                        -fx-padding: 14 20; -fx-cursor: hand; -fx-background-radius: 0;
                        -fx-alignment: CENTER_LEFT;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Logout"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(0,0,0,0.2); -fx-text-fill: #ffcccc;
                           -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 12 20;
                           -fx-cursor: hand; -fx-background-radius: 0; -fx-alignment: CENTER_LEFT;"/>

            <VBox style="-fx-padding: 12 16; -fx-background-color: rgba(0,0,0,0.1);
                         -fx-background-radius: 8; -fx-margin: 0 10;">
                <Label text="💡 Tip"
                       style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label text="Add books to share with the community."
                       wrapText="true"
                       style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 10px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 28;">

            <!-- ADD BOOK PANEL -->
            <VBox fx:id="addBookPanel" spacing="20"
                  maxWidth="660" maxHeight="260"
                  StackPane.alignment="TOP_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 28; -fx-effect: dropshadow(gaussian, #b2dfcc, 12, 0, 0, 4);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="＋"
                           style="-fx-background-color: #d5f5e3; -fx-text-fill: #27ae60;
                                  -fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-padding: 6 12; -fx-background-radius: 8;"/>
                    <VBox spacing="1">
                        <Label text="Add a New Book"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Fill in the details below and hit Add Book"
                               style="-fx-font-size: 11px; -fx-text-fill: #aab4c8;"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="isbnField" promptText="ISBN" prefWidth="120"
                               style="-fx-background-radius: 8; -fx-border-color: #d5f5e3;
                                      -fx-border-radius: 8; -fx-padding: 10 12;
                                      -fx-font-size: 13px; -fx-background-color: #f4fdf7;"/>
                    <TextField fx:id="titleField" promptText="Title" prefWidth="150"
                               style="-fx-background-radius: 8; -fx-border-color: #d5f5e3;
                                      -fx-border-radius: 8; -fx-padding: 10 12;
                                      -fx-font-size: 13px; -fx-background-color: #f4fdf7;"/>
                    <TextField fx:id="authorField" promptText="Author" prefWidth="130"
                               style="-fx-background-radius: 8; -fx-border-color: #d5f5e3;
                                      -fx-border-radius: 8; -fx-padding: 10 12;
                                      -fx-font-size: 13px; -fx-background-color: #f4fdf7;"/>
                    <TextField fx:id="genreField" promptText="Genre" prefWidth="130"
                               style="-fx-background-radius: 8; -fx-border-color: #d5f5e3;
                                      -fx-border-radius: 8; -fx-padding: 10 12;
                                      -fx-font-size: 13px; -fx-background-color: #f4fdf7;"/>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Button text="＋  Add Book" onAction="#handleAddBook"
                            style="-fx-background-color: linear-gradient(to right, #27ae60, #16a085);
                                   -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-padding: 10 24; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, #27ae6066, 8, 0, 0, 3);"/>
                    <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

                     <!-- LENT BOOKS PANEL -->
                     <VBox fx:id="lentBooksPanel" spacing="14"
                              StackPane.alignment="TOP_LEFT"
                              visible="false" managed="false"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                           -fx-padding: 28; -fx-effect: dropshadow(gaussian, #b2dfcc, 12, 0, 0, 4);">

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                   <Label text="📖"
                                             style="-fx-background-color: #d5f5e3; -fx-font-size: 16px;
                                                          -fx-padding: 6 10; -fx-background-radius: 8;"/>
                                   <VBox spacing="1">
                                          <Label text="Lent Books"
                                                    style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                          <Label text="Books currently lent to users"
                                                    style="-fx-font-size: 11px; -fx-text-fill: #aab4c8;"/>
                                   </VBox>
                            </HBox>

                            <TableView fx:id="lentBooksTable" prefHeight="380" VBox.vgrow="ALWAYS"
                                             style="-fx-background-radius: 10; -fx-border-color: #d5f5e3;
                                                          -fx-border-radius: 10; -fx-font-size: 13px;">
                                   <columns>
                                          <TableColumn fx:id="lentIsbnColumn"   text="ISBN"   prefWidth="120"/>
                                          <TableColumn fx:id="lentTitleColumn"  text="Title"  prefWidth="160"/>
                                          <TableColumn fx:id="lentBorrowerColumn" text="Borrower" prefWidth="130"/>
                                          <TableColumn fx:id="lentBorrowDateColumn" text="Borrow Date" prefWidth="120"/>
                                          <TableColumn fx:id="lentDueDateColumn"  text="Due Date"  prefWidth="120"/>
                                   </columns>
                                   <placeholder>
                                          <Label text="No books are currently lent out."
                                                    style="-fx-text-fill: #c0c8d8; -fx-font-size: 13px;"/>
                                   </placeholder>
                            </TableView>

                            <Label fx:id="lentBooksStatusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                     </VBox>

            <!-- INVENTORY PANEL -->
            <VBox fx:id="inventoryPanel" spacing="14"
                  StackPane.alignment="TOP_LEFT"
                  visible="false" managed="false"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 28; -fx-effect: dropshadow(gaussian, #b2dfcc, 12, 0, 0, 4);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋"
                           style="-fx-background-color: #d5f5e3; -fx-font-size: 16px;
                                  -fx-padding: 6 10; -fx-background-radius: 8;"/>
                    <VBox spacing="1">
                        <Label text="My Inventory"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="All books you have listed"
                               style="-fx-font-size: 11px; -fx-text-fill: #aab4c8;"/>
                    </VBox>
                </HBox>

                <TableView fx:id="bookTable" prefHeight="380" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 10; -fx-border-color: #d5f5e3;
                                  -fx-border-radius: 10; -fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="isbnColumn"   text="ISBN"   prefWidth="120"/>
                        <TableColumn fx:id="titleColumn"  text="Title"  prefWidth="160"/>
                        <TableColumn fx:id="authorColumn" text="Author" prefWidth="130"/>
                        <TableColumn fx:id="genreColumn"  text="Genre"  prefWidth="120"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="No books in your inventory yet."
                               style="-fx-text-fill: #c0c8d8; -fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="14"/>
                    </VBox.margin>
                    <Button fx:id="editBookBtn" text="Edit" disable="true"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    <Button fx:id="toggleAvailBtn" text="Mark Unavailable" disable="true"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    <Button fx:id="delistBookBtn" text="Delist" disable="true"
                            style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    <Button fx:id="deleteBookBtn" text="Delete" disable="true"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="inventoryStatusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- PENDING REQUESTS PANEL -->
            <VBox fx:id="pendingRequestsPanel" spacing="14"
                  StackPane.alignment="TOP_LEFT"
                  visible="false" managed="false"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 28; -fx-effect: dropshadow(gaussian, #b2dfcc, 12, 0, 0, 4);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⏳"
                           style="-fx-background-color: #d5f5e3; -fx-font-size: 16px;
                                  -fx-padding: 6 10; -fx-background-radius: 8;"/>
                    <VBox spacing="1">
                        <Label text="Pending Borrow Requests"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Review and respond to borrow requests from members."
                               style="-fx-font-size: 11px; -fx-text-fill: #aab4c8;"/>
                    </VBox>
                </HBox>

                <TableView fx:id="pendingRequestsTable" prefHeight="380" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 10; -fx-border-color: #d5f5e3;
                                  -fx-border-radius: 10; -fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="reqBorrowerColumn" text="Borrower"     prefWidth="110"/>
                        <TableColumn fx:id="reqBookColumn"     text="Book Title"   prefWidth="200"/>
                        <TableColumn fx:id="reqDueDateColumn"  text="Due Date"     prefWidth="110"/>
                        <TableColumn fx:id="reqDateColumn"     text="Requested On" prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="No pending requests. All caught up!"
                               style="-fx-text-fill: #c0c8d8; -fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="14"/>
                    </VBox.margin>
                    <Button fx:id="acceptRequestBtn" text="✓  Accept" disable="true"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    <Button fx:id="rejectRequestBtn" text="✕  Reject" disable="true"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="pendingRequestsStatusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>