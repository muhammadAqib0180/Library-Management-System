<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.LenderDashboardController"
           prefWidth="1100" prefHeight="720"
           stylesheets="@../css/modern-table.css"
           style="-fx-background-color: #F3F4F6; -fx-font-family: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif';">

    <BorderPane>

        <top>
            <BorderPane style="-fx-background-color: #0F766E; -fx-border-color: #115E59; -fx-border-width: 0 0 1 0; -fx-padding: 16 28;">
                <center>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="LN"
                               style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #0F766E; -fx-background-color: #CCFBF1; -fx-padding: 4 8; -fx-background-radius: 6;"/>
                        <VBox spacing="2">
                            <Label text="Library Nexus"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: 800; -fx-letter-spacing: -0.5;"/>
                            <Label text="Lender Workspace"
                                   style="-fx-text-fill: #99F6E4; -fx-font-size: 11px; -fx-font-weight: 600; -fx-text-transform: uppercase;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="welcomeLabel"
                               style="-fx-text-fill: #CCFBF1; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 0 16 0 0;"/>

                        <StackPane prefWidth="32" prefHeight="32" alignment="TOP_RIGHT" style="-fx-padding: 0;">
                            <Label fx:id="notificationBell" text="🔔"
                                   style="-fx-font-size: 18px; -fx-text-fill: #CCFBF1; -fx-cursor: hand;"
                                   onMouseClicked="#toggleNotificationPanel"
                                   StackPane.alignment="CENTER"/>
                            <Label fx:id="notificationBadge" text="0"
                                   style="-fx-text-fill: white; -fx-background-color: #EF4444;
                                          -fx-font-size: 9px; -fx-font-weight: bold;
                                          -fx-padding: 0 4; -fx-background-radius: 8;
                                          -fx-alignment: CENTER; -fx-min-width: 16; -fx-min-height: 16;"
                                   onMouseClicked="#toggleNotificationPanel"
                                   StackPane.alignment="TOP_RIGHT" translateX="4" translateY="-4"/>
                        </StackPane>

                        <Button text="Switch to Borrower"
                                onAction="#switchToBorrower"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #FFFFFF; -fx-font-weight: 700; -fx-font-size: 12px;
                                       -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;
                                       -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 6; -fx-border-width: 1; -fx-margin: 0 0 0 16;"/>
                    </HBox>
                </center>
                <right>
                </right>
            </BorderPane>
        </top>

        <left>
            <VBox prefWidth="240"
                  style="-fx-background-color: linear-gradient(to bottom, #0F766E, #115E59); -fx-padding: 24 16; -fx-spacing: 8;">

                <Label text="WORKSPACE"
                       style="-fx-text-fill: #5EEAD4; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 0 12 12 12; -fx-letter-spacing: 1.0;"/>

                <Button fx:id="btnAddBook" text="Add New Book" onAction="#showAddBookPanel" maxWidth="Infinity"/>

                <Button fx:id="btnInventory" text="My Inventory"
                        onAction="#showInventoryPanel" maxWidth="Infinity"/>

                <Button fx:id="btnPendingRequests" text="Incoming Requests"
                        onAction="#showPendingRequestsPanel" maxWidth="Infinity"/>

                <Button fx:id="btnLentBooks" text="Active Loans"
                        onAction="#showLentBooksPanel" maxWidth="Infinity"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Sign Out"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        style="-fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: #FDA4AF; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 12 16; -fx-cursor: hand; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 8;"/>
            </VBox>
        </left>

        <center>
            <StackPane fx:id="contentArea" style="-fx-padding: 32;">

                <VBox fx:id="addBookPanel" spacing="24"
                      StackPane.alignment="TOP_LEFT" visible="true" managed="true"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12;
                             -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                    <effect><DropShadow color="#0000000D" radius="20" spread="0.0" offsetY="4"/></effect>

                    <VBox spacing="4">
                        <Label text="Publish New Asset" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                        <Label text="Add a new book to your inventory to start lending." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                    </VBox>

                    <HBox spacing="40" VBox.vgrow="ALWAYS">

                        <VBox spacing="16" prefWidth="380">
                            <VBox spacing="6">
                                <Label text="ISBN Number" style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                                <TextField fx:id="isbnField" promptText="e.g., 978-3-16-148410-0"
                                           style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Book Title" style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                                <TextField fx:id="titleField" promptText="e.g., The Pragmatic Programmer"
                                           style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Author" style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                                <TextField fx:id="authorField" promptText="e.g., Andy Hunt"
                                           style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Genre" style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                                <TextField fx:id="genreField" promptText="e.g., Technology, Fiction"
                                           style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"/>
                            </VBox>
                        </VBox>

                        <VBox spacing="16" prefWidth="380">
                            <VBox spacing="6">
                                <Label text="Book Condition" style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="conditionCombo" prefWidth="400" promptText="Select Condition"
                                          style="-fx-padding: 6; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Physical Book Photo (Optional)" style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="bookImageField" HBox.hgrow="ALWAYS" promptText="No file selected" editable="false"
                                               style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"/>
                                    <Button fx:id="bookImageBtn" text="Browse..."
                                            style="-fx-background-color: #E5E7EB; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-padding: 10 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" minHeight="40"/>

                            <VBox spacing="10" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                                <Label fx:id="statusLabel" text="" style="-fx-font-size: 13px; -fx-font-weight: bold;" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                                <Button fx:id="btnNavAddBook" text="Publish Asset to Catalog" onAction="#handleAddBook" style="-fx-background-color: #C0C0C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-pref-width: 400;"/>
                            </VBox>
                        </VBox>

                    </HBox>
                </VBox>

                <VBox fx:id="inventoryPanel" spacing="20"
                      StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                    <effect><DropShadow color="#0000000D" radius="20" spread="0.0" offsetY="4"/></effect>

                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="4">
                            <Label text="My Inventory" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                            <Label text="Manage availability and edit details of your listed books." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="inventorySearchField" promptText="Search inventory..." prefWidth="260"
                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </HBox>

                    <TableView fx:id="bookTable" prefHeight="360" VBox.vgrow="ALWAYS"
                               style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-font-size: 13px;">
                        <columns>
                            <TableColumn fx:id="coverColumn" text="Cover" prefWidth="60" />
                            <TableColumn fx:id="isbnColumn"   text="ISBN"   prefWidth="130"/>
                            <TableColumn fx:id="titleColumn"  text="Title"  prefWidth="220"/>
                            <TableColumn fx:id="authorColumn" text="Author" prefWidth="160"/>
                            <TableColumn fx:id="genreColumn"  text="Genre"  prefWidth="120"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="editBookBtn" text="Edit Details" disable="true"
                                style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-font-weight: 700; -fx-padding: 10 20; -fx-background-radius: 6; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #E5E7EB; -fx-border-radius: 6;"/>
                        <Button fx:id="toggleAvailBtn" text="Toggle Status" disable="true"
                                style="-fx-background-color: #FEF3C7; -fx-text-fill: #B45309; -fx-font-weight: 700; -fx-padding: 10 20; -fx-background-radius: 6; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #FDE68A; -fx-border-radius: 6;"/>
                        <Button fx:id="delistBookBtn" text="Delist" disable="true"
                                style="-fx-background-color: #FFEDD5; -fx-text-fill: #C2410C; -fx-font-weight: 700; -fx-padding: 10 20; -fx-background-radius: 6; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #FED7AA; -fx-border-radius: 6;"/>
                        <Button fx:id="deleteBookBtn" text="Delete" disable="true"
                                style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-font-weight: 700; -fx-padding: 10 20; -fx-background-radius: 6; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #FECACA; -fx-border-radius: 6;"/>

                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="inventoryStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </HBox>
                </VBox>

                <VBox fx:id="pendingRequestsPanel" spacing="20"
                      StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                    <effect><DropShadow color="#0000000D" radius="20" spread="0.0" offsetY="4"/></effect>

                    <VBox spacing="4">
                        <Label text="Pending Approvals" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                        <Label text="Review incoming requests from members to borrow your assets." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                    </VBox>

                    <TableView fx:id="pendingRequestsTable" prefHeight="380" VBox.vgrow="ALWAYS"
                               style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-font-size: 13px;">
                        <columns>
                            <TableColumn fx:id="reqBorrowerColumn" text="Borrower ID"  prefWidth="130"/>
                            <TableColumn fx:id="reqBookColumn"     text="Asset Requested" prefWidth="240"/>
                            <TableColumn fx:id="reqDueDateColumn"  text="Proposed Return" prefWidth="140"/>
                            <TableColumn fx:id="reqDateColumn"     text="Request Date"    prefWidth="140"/>
                            <TableColumn fx:id="reqActionColumn"   text="Actions"         prefWidth="200"   style="-fx-alignment: CENTER_LEFT;" />
                        </columns>
                    </TableView>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="pendingRequestsStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </HBox>
                </VBox>

                <VBox fx:id="lentBooksPanel" spacing="20"
                      StackPane.alignment="TOP_LEFT" visible="false" managed="false"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 32; -fx-border-color: #E5E7EB; -fx-border-radius: 12;">
                    <effect><DropShadow color="#0000000D" radius="20" spread="0.0" offsetY="4"/></effect>

                    <VBox spacing="4">
                        <Label text="Active Loans" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                        <Label text="Track assets currently in possession of other members." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                    </VBox>

                    <TableView fx:id="lentBooksTable" prefHeight="400" VBox.vgrow="ALWAYS"
                               style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-font-size: 13px;">
                        <columns>
                            <TableColumn fx:id="lentIsbnColumn"   text="ISBN"   prefWidth="130"/>
                            <TableColumn fx:id="lentTitleColumn"  text="Title"  prefWidth="220"/>
                            <TableColumn fx:id="lentBorrowerColumn" text="Borrower" prefWidth="140"/>
                            <TableColumn fx:id="lentBorrowDateColumn" text="Issue Date" prefWidth="120"/>
                            <TableColumn fx:id="lentDueDateColumn"  text="Return Date"  prefWidth="120"/>
                        </columns>
                    </TableView>

                    <Label fx:id="lentBooksStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                </VBox>

            </StackPane>
        </center>
    </BorderPane>

    <VBox fx:id="notificationPanel" visible="false" managed="false"
          StackPane.alignment="TOP_RIGHT"
          prefWidth="320" maxWidth="320" maxHeight="400" minHeight="100"
          translateX="-28" translateY="70"
          style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB;
                 -fx-border-radius: 12; -fx-background-radius: 12;
                 -fx-padding: 0; -fx-spacing: 0; -fx-border-width: 1;">

        <effect><DropShadow color="#00000033" radius="24" spread="0.0" offsetY="8"/></effect>

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #F9FAFB; -fx-padding: 16;
                     -fx-border-color: transparent transparent #E5E7EB transparent; -fx-border-width: 1; -fx-background-radius: 12 12 0 0;">
            <Label text="Notifications" style="-fx-text-fill: #111827; -fx-font-weight: 800; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#toggleNotificationPanel"
                    style="-fx-font-size: 14px; -fx-text-fill: #6B7280; -fx-font-weight: bold;
                           -fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 4;"/>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
            <VBox fx:id="notificationListContainer" spacing="0" style="-fx-background-color: transparent;">
                <Label text="Loading notifications..." style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px; -fx-padding: 16;"/>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>