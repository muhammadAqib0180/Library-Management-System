<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LenderDashboardController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f4f6f9;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 15 20;">
            <Label text="📚 Lender Dashboard"
                   style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;"/>
            <Button text="Switch to Borrower ▶"
                    onAction="#switchToBorrower"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 20;
                           -fx-padding: 7 18; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="5"
              style="-fx-background-color: #34495e; -fx-padding: 15 0;">

            <Label text="MENU"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 0 20 8 20;"/>

            <Button fx:id="btnAddBook" text="＋  Add New Book"
                    onAction="#showAddBookPanel"
                    maxWidth="Infinity"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13;
                           -fx-padding: 12 20; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>

            <Button fx:id="btnInventory" text="📋  My Inventory"
                    onAction="#showInventoryPanel"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1;
                           -fx-font-size: 13; -fx-padding: 12 20; -fx-cursor: hand;
                           -fx-background-radius: 0; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT (swappable panels) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 25;">

            <!-- ADD BOOK PANEL -->
            <VBox fx:id="addBookPanel" spacing="15"
                  style="-fx-background-color: white; -fx-padding: 25;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(gaussian, #cccccc, 6, 0, 0, 2);"
                  maxHeight="220" maxWidth="620"
                  StackPane.alignment="TOP_LEFT">

                <Label text="Add a New Book"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="isbnField" promptText="ISBN" prefWidth="140"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8;"/>
                    <TextField fx:id="titleField" promptText="Title" prefWidth="200"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8;"/>
                    <TextField fx:id="authorField" promptText="Author" prefWidth="160"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="+ Add Book" onAction="#handleAddBook"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;
                                   -fx-background-radius: 5; -fx-font-weight: bold;
                                   -fx-padding: 9 20; -fx-cursor: hand;"/>
                    <Label fx:id="statusLabel" style="-fx-font-size: 12;"/>
                </HBox>
            </VBox>

            <!-- INVENTORY PANEL -->
            <VBox fx:id="inventoryPanel" spacing="10"
                  style="-fx-background-color: white; -fx-padding: 25;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(gaussian, #cccccc, 6, 0, 0, 2);"
                  StackPane.alignment="TOP_LEFT"
                  visible="false" managed="false">

                <Label text="My Inventory"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <TableView fx:id="bookTable" prefHeight="400" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 5;">
                    <columns>
                        <TableColumn fx:id="isbnColumn"   text="ISBN"   prefWidth="150"/>
                        <TableColumn fx:id="titleColumn"  text="Title"  prefWidth="230"/>
                        <TableColumn fx:id="authorColumn" text="Author" prefWidth="180"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No books in your inventory yet." style="-fx-text-fill: #aaa;"/>
                    </placeholder>
                </TableView>
            </VBox>

        </StackPane>
    </center>

</BorderPane>