<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<StackPane prefHeight="500.0" prefWidth="900.0"
           style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #000000);"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoginController">

    <VBox alignment="CENTER" maxWidth="650.0" spacing="12.0"
          style="-fx-background-color: rgba(240, 240, 240, 0.95); -fx-background-radius: 15;">
        <padding>
            <Insets bottom="20.0" left="60.0" right="60.0" top="20.0"/>
        </padding>
        <effect><DropShadow color="#000000aa" radius="15" /></effect>

        <Label text="LIBRARY NEXUS" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <HBox alignment="CENTER" spacing="0">
            <ToggleButton fx:id="loginTab" selected="true" text="LOGIN" onAction="#showLoginView"
                          style="-fx-background-radius: 25 0 0 25; -fx-padding: 8 60; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <ToggleButton fx:id="signupTab" text="SIGN UP" onAction="#showSignupView"
                          style="-fx-background-radius: 0 25 25 0; -fx-padding: 8 60; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>

        <TextField fx:id="usernameField" promptText="Username"
                   style="-fx-background-radius: 25; -fx-padding: 12;" maxWidth="500.0"/>

        <PasswordField fx:id="passwordField" promptText="Password"
                       style="-fx-background-radius: 25; -fx-padding: 12;" maxWidth="500.0"/>

        <ComboBox fx:id="roleComboBox" visible="false" managed="false" prefWidth="500.0" promptText="Select Role"
                  style="-fx-background-radius: 25;"/>

        <Button fx:id="submitButton" text="SIGN IN" onAction="#handleSubmit"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 100; -fx-cursor: hand;" />

        <Label fx:id="statusLabel" textFill="#e74c3c" style="-fx-font-weight: bold;" />
    </VBox>
</StackPane>