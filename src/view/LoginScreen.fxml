<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="560.0" prefWidth="960.0"
           style="-fx-background-color: #0F172A; -fx-font-family: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif';"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoginController">

    <Circle radius="250" fill="#1E3A8A" StackPane.alignment="TOP_LEFT" translateX="-50" translateY="-50" style="-fx-opacity: 0.6;">
        <effect><GaussianBlur radius="60"/></effect>
    </Circle>

    <Circle radius="300" fill="#5B21B6" StackPane.alignment="BOTTOM_RIGHT" translateX="100" translateY="100" style="-fx-opacity: 0.5;">
        <effect><GaussianBlur radius="60"/></effect>
    </Circle>

    <Circle radius="200" fill="#0F766E" StackPane.alignment="CENTER" translateX="150" translateY="-150" style="-fx-opacity: 0.4;">
        <effect><GaussianBlur radius="60"/></effect>
    </Circle>

    <VBox alignment="CENTER" maxWidth="420.0" spacing="24.0"
          style="-fx-background-color: linear-gradient(to bottom right, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
                 -fx-background-radius: 24; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 24;">
        <padding>
            <Insets top="48" bottom="48" left="48" right="48"/>
        </padding>
        <effect>
            <DropShadow color="#00000066" radius="40" spread="0.0" offsetY="15"/>
        </effect>

        <VBox alignment="CENTER" spacing="8">
            <Label text="Library Nexus"
                   style="-fx-text-fill: #F8FAFC; -fx-font-size: 28px; -fx-font-weight: 900; -fx-letter-spacing: -0.5;"/>
            <Label text="Authenticate to access your workspace."
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
        </VBox>

        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 10 0;">
            <ToggleButton fx:id="loginTab" selected="true" text="Sign In"
                          onAction="#showLoginView"
                          style="-fx-background-color: transparent; -fx-cursor: hand;"/>
            <ToggleButton fx:id="signupTab" text="Create Account"
                          onAction="#showSignupView"
                          style="-fx-background-color: transparent; -fx-cursor: hand;"/>
        </HBox>

        <VBox spacing="16">
            <TextField fx:id="usernameField" promptText="Username"
                       style="-fx-background-color: rgba(0,0,0,0.25); -fx-text-fill: #F8FAFC; -fx-prompt-text-fill: #64748B; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 14px;"/>

            <StackPane alignment="CENTER_RIGHT">
                <TextField fx:id="passwordVisibleField" promptText="Password"
                           visible="false" managed="false"
                           style="-fx-background-color: rgba(0,0,0,0.25); -fx-text-fill: #F8FAFC; -fx-prompt-text-fill: #64748B; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 14px;"/>

                <PasswordField fx:id="passwordField" promptText="Password"
                               style="-fx-background-color: rgba(0,0,0,0.25); -fx-text-fill: #F8FAFC; -fx-prompt-text-fill: #64748B; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 14px;"/>

                <ToggleButton fx:id="togglePasswordBtn" text="Show" onAction="#togglePasswordVisibility"
                              style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 16 0 0;" />
            </StackPane>

            <ComboBox fx:id="roleComboBox" visible="false" managed="false"
                      maxWidth="Infinity" promptText="Select Role"
                      style="-fx-background-color: rgba(0,0,0,0.25); -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4; -fx-font-size: 14px;"/>
        </VBox>

        <Button fx:id="submitButton" text="Sign In" onAction="#handleSubmit"
                maxWidth="Infinity"
                style="-fx-background-color: #F8FAFC; -fx-text-fill: #0F172A; -fx-font-weight: 800; -fx-font-size: 14px; -fx-padding: 14; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Label fx:id="statusLabel" minHeight="20" style="-fx-font-size: 12px;"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="6"
          StackPane.alignment="BOTTOM_LEFT" maxWidth="150" maxHeight="30"
          translateX="24" translateY="-24">
        <Circle fx:id="systemStatusCircle" radius="4" fill="#94A3B8"/>
        <Label text="System Status"
               style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
    </HBox>
</StackPane>