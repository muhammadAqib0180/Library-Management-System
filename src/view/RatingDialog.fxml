<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Dialog?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<Dialog fx:id="dialog" title="Rate This Transaction" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RatingDialogController">
    <dialogPane>
        <DialogPane>
            <content>
                <VBox spacing="15" style="-fx-padding: 20;">
                    <!-- Header -->
                    <VBox spacing="5">
                        <Text fx:id="headerText" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <Text text="Your feedback helps build trust in our community." style="-fx-font-size: 11; -fx-fill: #666;" />
                    </VBox>

                    <!-- Star Rating -->
                    <VBox spacing="8">
                        <Label text="Rating (1–5 Stars)" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Spinner fx:id="starSpinner" prefWidth="80">
                                <valueFactory>
                                    <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="5" initialValue="5" />
                                </valueFactory>
                            </Spinner>
                            <Text fx:id="starEmoji" style="-fx-font-size: 24;" text="⭐⭐⭐⭐⭐" />
                        </HBox>
                    </VBox>

                    <!-- Comment -->
                    <VBox spacing="8">
                        <Label text="Comments (Optional)" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                        <TextArea fx:id="commentField" wrapText="true" prefHeight="80" promptText="Share your experience... (e.g., 'Prompt delivery', 'Book in great condition')" />
                    </VBox>

                    <!-- Buttons -->
                    <HBox spacing="10" style="-fx-alignment: center-right; -fx-padding: 10 0 0 0;">
                        <Button fx:id="skipButton" text="Skip" style="-fx-padding: 8 20;" />
                        <Button fx:id="submitButton" text="Submit Rating" style="-fx-padding: 8 20; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>
            </content>
        </DialogPane>
    </dialogPane>
</Dialog>
